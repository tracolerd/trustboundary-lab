{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrustBoundary Scenario Schema",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "name": { "type": "string" },
    "threat_category": { 
      "type": "string",
      "enum": ["direct_injection", "indirect_injection", "unauthorized_tool", "canary_leak"]
    },
    "input_payload": { "type": "string" },
    "expected_safe_behavior": { "type": "string" },
    "assertion": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["type", "value"]
    }
  },
  "required": ["id", "version", "name", "threat_category", "input_payload", "expected_safe_behavior", "assertion"]
}
